#!/usr/bin/env bash
# Codex hook -> Sense HAT 状态灯
#
# 事件映射:
#   UserPromptSubmit / PreToolUse / PostToolUse / 子agent / 压缩 -> 黄灯（处理中）
#   PermissionRequest                                          -> 红灯（需要确认）
#   Stop                                                       -> 绿灯（运行完毕）
#   SessionStart(/clear) / Interrupt                           -> 灭灯
#   SessionEnd                                                 -> 不处理（见下）
#
# Codex 会把 hook 事件 JSON 从 stdin 送进来，本脚本读完（必须读）后立刻返回，
# 永远不输出内容、永远 exit 0，避免影响 agent 本身。
#
# 每个事件都带上 session_id，树莓派按会话分别记账再汇总出灯效，
# 所以开多个窗口时：只要有一个在等确认就红灯，有一个在跑就至少黄灯。
set -u

SENSE_BIN="${SENSE_BIN:-/Users/photo-king/Projects/agent-led/bin/sense}"
SENSE_HOOK_LOG="${SENSE_HOOK_LOG:-/tmp/sense-hook.log}"

payload="$(cat 2>/dev/null || true)"
flat="$(printf '%s' "$payload" | tr '\n\r' '  ')"

event="$(printf '%s' "$flat" | sed -n 's/.*"hook_event_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
if [ -z "$event" ]; then
  event="$(printf '%s' "$flat" | sed -n 's/.*"hookEventName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
fi

sid="$(printf '%s' "$flat" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
sid="$(printf '%s' "${sid:-nosession}" | cut -c1-12)"

case "$event" in
  UserPromptSubmit|PreToolUse|PostToolUse|SubagentStart|SubagentStop|PreCompact|PostCompact)
    state=busy ;;
  PermissionRequest)
    state=confirm ;;
  Stop)
    state=done ;;
  SessionStart|Interrupt)
    state=idle ;;
  *)
    # SessionEnd 不参与灯效：桌面版每轮回复结束后都会补一个 SessionEnd，
    # 如果让它灭灯，绿灯就只亮两秒。
    exit 0 ;;
esac

printf '%s [%s] %s -> %s\n' "$(date '+%F %T')" "$sid" "${event:-unknown}" "$state" >>"$SENSE_HOOK_LOG" 2>/dev/null

export SENSE_HTTP_TIMEOUT="${SENSE_HTTP_TIMEOUT:-3}"
export SENSE_SESSION="$sid"
export SENSE_EVENT="${event:-}"
exec "$SENSE_BIN" "$state" >/dev/null 2>&1
